[
  // MARK: - Left sidebar a-la Xcode

  {
    "key": "cmd+1",
    "command": "workbench.view.explorer",
  },
  {
    "key": "cmd+1",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.explorer'"
  },
  {
    "key": "cmd+2",
    "command": "workbench.view.search"
  },
  {
    "key": "cmd+2",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.search'"
  },
  {
    "key": "cmd+3",
    "command": "workbench.view.scm"
  },
  {
    "key": "cmd+3",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.scm'"
  },
  {
    "key": "cmd+4",
    "command": "workbench.view.debug"
  },
  {
    "key": "cmd+4",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.debug'"
  },
  {
    "key": "cmd+5",
    "command": "workbench.view.extensions"
  },
  {
    "key": "cmd+5",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.extensions'"
  },
  {
    "key": "cmd+6",
    "command": "workbench.view.testing.focus"
  },
  // {
  //   "key": "cmd+6",
  //   "command": "workbench.action.closeSidebar",
  //   "when": "sideBarVisible && activeViewlet == 'workbench.view.testing.focus'"
  // },

  // MARK: - Debugger

  {
    "key": "cmd+\\",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus"
  },

  // MARK: - Terminal and panel

  {
    // Focus the panel if not focused, toggle otherwise
    "key": "cmd+j",
    "command": "workbench.action.focusPanel",
    "when": "!panelFocus"
  },
  {
    "key": "cmd+`",
    "command": "workbench.action.terminal.toggleTerminal",
  },
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus && !terminalEditorFocus"
  },
  {
    // Prevent cmd+w from closing the file when the terminal is focused,
    "key": "cmd+w",
    "command": "",
    "when": "terminalFocus && !terminalEditorFocus"
  },

  // MARK: - AI sidebar

  {
    "key": "cmd+shift+i",
    "command": "workbench.action.toggleAuxiliaryBar",
  },

  // MARK: - Remove Gemini Code Assist keybinding since it conflicts with the built-in AI chat

  {
    "key": "cmd+i",
    "command": "-geminicodeassist.showinEditor",
    "when": "authLoggedIn && config.geminicodeassist.enable && editorTextFocus && shouldRegisterInEditorCommand && !inGeminiDiffView && !isInDiffEditor"
  },
]
