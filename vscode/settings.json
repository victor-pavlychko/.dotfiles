{
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.accessibilitySupport": "off",
    "editor.fontFamily": "Liga SFMono Nerd Font",
    "editor.fontLigatures": true,
    "git.openDiffOnClick": false,
    "javascript.updateImportsOnPaste.enabled": false,
    "scm.defaultViewMode": "tree",
    "typescript.updateImportsOnPaste.enabled": false,
    "window.commandCenter": true,
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.tree.renderIndentGuides": "always",
    "workbench.colorCustomizations": {
        // Dim tree indent guides
        "tree.indentGuidesStroke": "#80808011",
        "tree.inactiveIndentGuidesStroke": "#80808011",

        // Dim whitespace characters and code indent guides
        "editorWhitespace.foreground": "#80808022",
        "editorIndentGuide.background1": "#80808011",
        "editorIndentGuide.activeBackground1": "#80808033",

        // VScode-like terminal colors
        "terminal.ansiBlack": "#272c36",
        "terminal.ansiBlue": "#81a1c1",
        "terminal.ansiBrightBlack": "#4c566a",
        "terminal.ansiBrightBlue": "#81a1c1",
        "terminal.ansiBrightCyan": "#8fbcbb",
        "terminal.ansiBrightGreen": "#a3be8c",
        "terminal.ansiBrightMagenta": "#b48ead",
        "terminal.ansiBrightRed": "#bf616a",
        "terminal.ansiBrightWhite": "#eceff4",
        "terminal.ansiBrightYellow": "#ebcb8b",
        "terminal.ansiCyan": "#88c0d0",
        "terminal.ansiGreen": "#a3be8c",
        "terminal.ansiMagenta": "#7d7c9b",
        "terminal.ansiRed": "#bf616a",
        "terminal.ansiWhite": "#e5e9f0",
        "terminal.ansiYellow": "#ebcb8b",
        // "terminal.background": "#191c22",
        "terminal.foreground": "#d8dee9",
        "terminal.selectionBackground": "#434c5e55",
        "terminalCursor.background": "#8fbcbb22",
        "terminalCursor.foreground": "#8fbcbb",

        // Ghostty-like terminal colors
        // "terminal.ansiBlack": "#1d1f21",
        // "terminal.ansiRed": "#cc6566",
        // "terminal.ansiGreen": "#b6bd68",
        // "terminal.ansiYellow": "#f0c674",
        // "terminal.ansiBlue": "#82a2be",
        // "terminal.ansiMagenta": "#b294bb",
        // "terminal.ansiCyan": "#8abeb7",
        // "terminal.ansiWhite": "#c4c8c6",
        // "terminal.ansiBrightBlack": "#666666",
        // "terminal.ansiBrightRed": "#d54e53",
        // "terminal.ansiBrightGreen": "#b9ca4b",
        // "terminal.ansiBrightYellow": "#e7c547",
        // "terminal.ansiBrightBlue": "#7aa6da",
        // "terminal.ansiBrightMagenta": "#c397d8",
        // "terminal.ansiBrightCyan": "#70c0b1",
        // "terminal.ansiBrightWhite": "#eaeaea",
        // "terminal.background": "#282c34",
        // "terminal.foreground": "#ffffff",
        // "terminalCursor.background": "#ffffff22",
        // "terminalCursor.foreground": "#ffffff",
        // "terminal.selectionBackground": "#ffffff55",
        // "terminal.selectionForeground": "#282c34",
    },
    "redhat.telemetry.enabled": false,
    "extensions.ignoreRecommendations": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "*.jsonnet": "${capture}.json",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb"
    },
    "git.openRepositoryInParentFolders": "never",
    "diffEditor.renderSideBySide": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "python.analysis.typeCheckingMode": "standard",
    "chat.mcp.gallery.enabled": true,
    "typescript.tsserver.maxTsServerMemory": 8192,
    "claudeCode.preferredLocation": "sidebar",
    "terminal.integrated.suggest.enabled": false,
    "claudeCode.allowDangerouslySkipPermissions": true,
    "workbench.colorTheme": "Experimental Dark",
    "editor.minimap.enabled": false,
    "files.associations": {
        "*.json5": "json5"
    },
    "chat.viewSessions.orientation": "stacked",
    "terminal.integrated.initialHint": false,
    "chatgpt.commentCodeLensEnabled": false,
    "editor.renderWhitespace": "all",
}
