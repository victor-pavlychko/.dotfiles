{
  // Discovery
  "extensions.ignoreRecommendations": true,
  "git.openRepositoryInParentFolders": "never",

  // Shell
  "window.title": "🌿 ${activeRepositoryBranchName}${separator}📂 ${rootName}",
  "window.nativeTabs": true,
  "window.systemColorTheme": "dark",
  "workbench.browser.showInTitleBar": false,
  "workbench.editor.closeEmptyGroups": false,
  "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "maximize",
  "workbench.editor.useModal": "off",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "workbench.startupEditor": "none",
  "chat.viewSessions.orientation": "stacked",

  // Explorer
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.jsonnet": "${capture}.json",
    "requirements.txt": "requirements-*.txt",
    "__init__.py": "py.typed",
    "AGENTS.md": "CLAUDE.md",
  },

  "freshFileExplorer.autoExpandDepth": 10,
  "freshFileExplorer.blameHeatmap.autoApply": false,
  "freshFileExplorer.defaultOpenChangesMode": false,
  "freshFileExplorer.description.showAuthor": false,
  "freshFileExplorer.description.showCommitMessage": false,
  "freshFileExplorer.description.showStatus": false,
  "freshFileExplorer.flatList.labelStyle": "filename",
  "freshFileExplorer.heatmap.enabled": false,
  "freshFileExplorer.showBaseBranchSync": false,
  "freshFileExplorer.showCurrentBranchSync": false,
  "freshFileExplorer.timeWindows": [],

  // Editor
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "'Liga SFMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.lineNumbers": "on",
  // "editor.largeFileOptimizations": false,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "diffEditor.renderSideBySide": false,
  "files.trimTrailingWhitespace": true,

  // Themes
  "workbench.colorTheme": "Dark Modern 2026",
  "workbench.iconTheme": "catppuccin-macchiato",
  "workbench.tree.renderIndentGuides": "always",
  "excalidraw.theme": "dark",

  "catppuccin-icons.associations.folders": {
    "notebooks": "folder_storybook",
    "vendor": "folder_packages",
    "infra": "folder_cloud",
    "stubs": "folder_types",
    "tools": "folder_utils",
  },

  "workbench.colorCustomizations": {
    // Dim tree indent guides
    "tree.indentGuidesStroke": "#80808011",
    "tree.inactiveIndentGuidesStroke": "#80808011",
    // Dim whitespace characters and code indent guides
    "editorWhitespace.foreground": "#80808022",
    "editorIndentGuide.background1": "#80808011",
    "editorIndentGuide.activeBackground1": "#80808033",
    // VScode-like terminal colors
    "terminal.ansiBlack": "#272c36",
    "terminal.ansiBlue": "#81a1c1",
    "terminal.ansiBrightBlack": "#4c566a",
    "terminal.ansiBrightBlue": "#81a1c1",
    "terminal.ansiBrightCyan": "#8fbcbb",
    "terminal.ansiBrightGreen": "#a3be8c",
    "terminal.ansiBrightMagenta": "#b48ead",
    "terminal.ansiBrightRed": "#bf616a",
    "terminal.ansiBrightWhite": "#eceff4",
    "terminal.ansiBrightYellow": "#ebcb8b",
    "terminal.ansiCyan": "#88c0d0",
    "terminal.ansiGreen": "#a3be8c",
    "terminal.ansiMagenta": "#7d7c9b",
    "terminal.ansiRed": "#bf616a",
    "terminal.ansiWhite": "#e5e9f0",
    "terminal.ansiYellow": "#ebcb8b",
    // "terminal.background": "#191c22",
    "terminal.foreground": "#d8dee9",
    "terminal.selectionBackground": "#434c5e55",
    "terminalCursor.background": "#8fbcbb22",
    "terminalCursor.foreground": "#8fbcbb",
    // Ghostty-like terminal colors
    // "terminal.ansiBlack": "#1d1f21",
    // "terminal.ansiRed": "#cc6566",
    // "terminal.ansiGreen": "#b6bd68",
    // "terminal.ansiYellow": "#f0c674",
    // "terminal.ansiBlue": "#82a2be",
    // "terminal.ansiMagenta": "#b294bb",
    // "terminal.ansiCyan": "#8abeb7",
    // "terminal.ansiWhite": "#c4c8c6",
    // "terminal.ansiBrightBlack": "#666666",
    // "terminal.ansiBrightRed": "#d54e53",
    // "terminal.ansiBrightGreen": "#b9ca4b",
    // "terminal.ansiBrightYellow": "#e7c547",
    // "terminal.ansiBrightBlue": "#7aa6da",
    // "terminal.ansiBrightMagenta": "#c397d8",
    // "terminal.ansiBrightCyan": "#70c0b1",
    // "terminal.ansiBrightWhite": "#eaeaea",
    // "terminal.background": "#282c34",
    // "terminal.foreground": "#ffffff",
    // "terminalCursor.background": "#ffffff22",
    // "terminalCursor.foreground": "#ffffff",
    // "terminal.selectionBackground": "#ffffff55",
    // "terminal.selectionForeground": "#282c34",
  },

  // Notebooks
  "notebook.lineNumbers": "on",
  "notebook.output.scrolling": true,
  "notebook.output.textLineLimit": 20,
  "jupyter.askForKernelRestart": false,
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],

  // Terminal
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.initialHint": false,

  // JS performace
  "js/ts.updateImportsOnPaste.enabled": false,
  "js/ts.tsserver.maxMemory": 16384,
  "typescript.tsserver.maxTsServerMemory": 16384,

  // Extensions
  "chatgpt.commentCodeLensEnabled": false,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.preferredLocation": "panel",
  "powermode.enabled": false,
  "redhat.telemetry.enabled": false,
  "python.locator": "js",
  "python.analysis.typeCheckingMode": "standard",
  "flake8.args": [
      "--max-line-length=1000",
  ],

  // File types
  "files.associations": {
    "*.json5": "json5",
  },

  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.md": "vscode.markdown.editor",
    "*.parquet": "gridMaster.parquetEditor"
  },

  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
  },

  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
}
